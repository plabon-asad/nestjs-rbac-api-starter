# Runtime environment: development | production | test
NODE_ENV=development
PORT=3000

# Database: postgresql | mysql
DATABASE_PROVIDER=postgresql
# postgresql: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# mysql:      mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://rbac:CHANGE_ME@localhost:5432/rbac_dev
# Integration/E2E tests use this isolated database (falls back to DATABASE_URL when unset)
TEST_DATABASE_URL=postgresql://rbac:CHANGE_ME@localhost:5432/rbac_test

# JWT — generate strong unique secrets, minimum 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=nestjs-rbac-api-starter
JWT_AUDIENCE=nestjs-rbac-api-starter-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Session cookie (refresh token transport)
COOKIE_SECURE=false

# Throttling
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

# Seed credentials — never commit real values
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
